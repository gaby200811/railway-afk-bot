# Copy this file to ".env" and fill in real values.
# On Railway, set these as Service Variables instead — .env is only read
# for local/VPS runs (dotenv never overrides variables the platform already set).

# ---- Admin account (required) ----
# This is the one built-in account. It is NOT stored in any file — it's
# checked directly against these two values on every login. The admin
# account is used to create/delete the real user accounts below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Session security (required) ----
# Generate a random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-character-hex-string

# Optional fallback: use a SOCKS5 proxy/VPN after an IP-limit kick.
# MC_PROXY=socks5://username:password@proxy-host:1080

# ---- Networking ----
# Railway/most PaaS providers set PORT automatically — leave it unset there.
# For a plain VPS, set the port you want the panel to listen on.
PORT=3000
PANEL_HOST=0.0.0.0

# ---- Production hardening ----
# Set to "production" once you're serving over HTTPS (enables secure cookies).
NODE_ENV=production

# ---- Optional: persistent storage ----
# If you're on Railway and attach a Volume, set this to its mount path so
# user accounts and each user's bot config/route survive redeploys.
# RAILWAY_VOLUME_MOUNT_PATH=/data
